<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Blog App</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <div class="container">
        <h1>Blog Page</h1>
        <hr>

        <div class="main-content">
            <div class="left-column">
                <div class="form-container">
                    <h2>Create a New Post</h2>
                    <form action="/create" method="POST">
                        <input type="text" name="author" placeholder="Name" required>
                        <input type="text" name="title" placeholder="Title" required>
                        <textarea name="content" placeholder="Blog post content" required></textarea>
                        
                        <select name="category" required>
                            <option value="" disabled selected>Select a Category</option>
                            <% categories.forEach(category => { %>
                                <option value="<%= category %>"><%= category %></option>
                            <% }) %>
                        </select>

                        <button type="submit">Publish</button>
                    </form>
                </div>
            </div>

            <div class="right-column">
                <div class="posts-container">
                    <h2>Recent Posts</h2>
                    <% if (posts.length > 0) { %>
                        <% posts.forEach(post => { %>
                            <div class="post">
                                <h3><%= post.title %></h3>
                                <p class="post-meta">Category: <%= post.category %> | by <%= post.author %> on <%= post.date %></p>
                                <p><%= post.content %></p>
                                <div class="post-actions">
                                    <a href="/edit/<%= post.id %>" class="btn">Edit</a>
                                    <form action="/delete/<%= post.id %>" method="POST" style="display:inline;">
                                        <button type="submit" class="btn delete-btn">Delete</button>
                                    </form>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <p>No posts yet ;p</p>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</body>
</html>